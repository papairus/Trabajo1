# Construcción Indice de Victimización -----------------------------------------
# Por medio de 32 victimizaciones divididas en 6 dimensiones:
# Delitos comunes: PA_5, PA_6, PA_7, PA_3, PA_1, PA_2, PA_4,
# Maltrato de cuidadores: PB_1, PB_2, PB_3, PB_4,
# Maltrado por pares: PC_1, PC_2, PC_3, PC_4, PC_5,
# Sexual: PD_1, PD_2, PD_3, PD_4, PD_5, PD_6, PD_7,
# Entornos violentos: PE_1, PE_2, PE_3, PE_4, PE_5, PE_6, PE_7
# Digitales: PF_1, PF_2


indice_victimizaciones = proc_data %>% 
  rowwise() %>%
  mutate(delitos = mean(c(PA_5, PA_6, PA_7, PA_3, PA_1, PA_2, PA_4)),
         cuidadores = mean(c(PB_1, PB_2, PB_3, PB_4)),
         pares= mean(c(PC_1, PC_2, PC_3, PC_4, PC_5)),
         sexual= mean(c(PD_1, PD_2, PD_3, PD_4, PD_5, PD_6, PD_7)),
  			 entornos= mean(c(PE_1, PE_2, PE_3, PE_4, PE_5, PE_6, PE_7)),
         digitales= mean(c(PF_1, PF_2))) %>% 
  ungroup()

indice_victimizaciones = indice_victimizaciones %>% 
