class(proc_data$sexo_migrante)
proc_data$sexo_migrante <- factor(proc_data$sexo_migrante,
levels = c(
"Mujer chilenx", "Mujer migrante",
"Hombre chilenx", "Hombre migrante",
"Otro chilenx", "Otro migrante"))
