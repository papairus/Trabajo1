entornos = mean(c_across(PE_1:PE_7), na.rm = TRUE),
digitales = mean(c_across(PF_1:PF_2), na.rm = TRUE),
victimizaciones = mean(c(delitos, cuidadores, pares, sexual, entornos, digitales), na.rm = TRUE)
) %>%
ungroup() %>%
