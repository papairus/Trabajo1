P1_4 == 13 | P1_5 == 13 ~ NA_integer_,  # "No sé" → NA
P1_4 != 1 | P1_5 != 1   ~ 1,            # Migrante
TRUE                   ~ 0             # Chilenx
),
migrante = factor(migrante,
levels = c(0, 1),
labels = c("Chilenx", "Migrante")))
